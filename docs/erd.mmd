erDiagram
    User ||--|| Wallet : "sở hữu"
    Wallet ||--o{ Transaction : "gửi"
    Wallet ||--o{ Transaction : "nhận"
    Transaction ||--o| OtpCode : "yêu cầu xác thực"
    Wallet ||--o{ Ledger : "ghi nhận biến động"
    Transaction ||--o{ Ledger : "sinh ra bút toán"

    User {
        int id PK
        string username
        string email
        string password_hash
        datetime created_at
    }

    Wallet {
        int id PK
        int user_id FK, UK
        decimal balance
        string currency
    }

    Transaction {
        int id PK
        int sender_wallet_id FK
        int receiver_wallet_id FK
        decimal amount
        string status
        datetime created_at
    }

    OtpCode {
        int id PK
        int transaction_id FK, UK
        string code
        datetime expires_at
        boolean is_used
    }

    Ledger {
        int id PK
        int wallet_id FK
        int transaction_id FK
        string type
        decimal amount
        decimal balance_after
        datetime created_at
    }
